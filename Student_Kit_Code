const int potPin = 15;

int readADC() {
  long sum = 0;

  for (int i = 0; i < 20; i++) {
    sum += analogRead(potPin);
    delay(2);
  }

  return sum / 20;
}

void setup() {
  Serial.begin(115200);
  analogSetAttenuation(ADC_11db);
}

void loop() {

  int adc = readADC();

  int64_t resistance = ((int64_t)adc * 1000000) / 4095;

  Serial.println(resistance);

  delay(200);
}
