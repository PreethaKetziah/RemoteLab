const int potPin = 15;

int readADC() {
  int sum = 0;
  for (int i = 0; i < 20; i++) {
    sum += analogRead(potPin);
    delay(2);
  }
  return sum / 20;
}

void setup() {
  Serial.begin(115200);
  analogSetAttenuation(ADC_11db);
}

void loop() {

  int adc = readADC();

  // Convert to resistance (0–5000 ohm)
  int resistance = map(adc, 0, 4095, 0, 5000);

  Serial.println(resistance);   // 👉 ONLY THIS

  delay(200);
}
